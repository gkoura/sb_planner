<mxfile host="app.diagrams.net" modified="2026-10-26T12:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="sb-planner-schema" name="Database schema"><mxGraphModel dx="825" dy="614" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#17365D;" value="SB Planner · SQLite data model" vertex="1"><mxGeometry height="45" width="900" x="30" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" value="PK = primary key · FK = foreign key · UQ = unique constraint · IDX = index  |  PlanningStatus: DRAFT → COLLECTING → READY → GENERATED → PUBLISHED  |  AvailabilityMode: AVAILABLE / UNAVAILABLE" vertex="1"><mxGeometry height="30" width="2100" x="30" y="42" as="geometry"/></mxCell><mxCell id="table-User" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacing=10;" value="&lt;table cellpadding='4' cellspacing='0' style='width:100%;font-family:Arial,sans-serif;color:#0F172A'&gt;&lt;tr&gt;&lt;td colspan='2' style='font-size:16px;font-weight:bold;color:#17365D'&gt;User &lt;span style='font-size:11px;font-weight:normal;color:#64748B'&gt;(user)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='font-size:11px;color:#475569;padding-bottom:8px'&gt;An authenticated person: engineer or administrator.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px;width:55px;color:#0F766E'&gt;&lt;b style='color:#0F766E'&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td style='font-size:11px'&gt;id: String&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px;widt