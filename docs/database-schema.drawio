        <mxCell id="table-AvailabilitySubmission" value="&lt;table cellpadding='4' cellspacing='0' style='width:100%;font-family:Arial,sans-serif;color:#0F172A'&gt;&lt;tr&gt;&lt;td colspan='2' style='font-size:16px;font-weight:bold;color:#17365D'&gt;AvailabilitySubmission &lt;span style='font-size:11px;font-weight:normal;color:#64748B'&gt;(AvailabilitySubmission)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='font-size:11px;color:#475569;padding-bottom:8px'&gt;One replaceable availability response for a participant in a month.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px;width:55px;color:#0F766E'&gt;&lt;b style='color:#0F766E'&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td style='font-size:11px'&gt;id: String&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px;width:55px;color:#0F766E'&gt;&lt;b style='color:#0F766E'&gt;FK · UQ&lt;/b&gt;&lt;/td&gt;&lt;td style='font-size:11px'&gt;planningMemberId: String&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px;width:55px;color:#0F766E'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='font-size:11px'&gt;mode: AvailabilityMode&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px;width:55px;color:#0F766E'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='font-size:11px'&gt;submittedAt: DateTime&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px;width:55px;color:#0F766E'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='font-size:11px'&gt;updatedAt: DateTime&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          
          
          
          
