        <mxCell id="table-Session" value="&lt;table cellpadding='4' cellspacing='0' style='width:100%;font-family:Arial,sans-serif;color:#0F172A'&gt;&lt;tr&gt;&lt;td colspan='2' style='font-size:16px;font-weight:bold;color:#17365D'&gt;Session &lt;span style='font-size:11px;font-weight:normal;color:#64748B'&gt;(session)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='font-size:11px;color:#475569;padding-bottom:8px'&gt;A signed-in browser session managed by Better Auth.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px;width:55px;color:#0F766E'&gt;&lt;b style='color:#0F766E'&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td style='font-size:11px'&gt;id: String&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px;width:55px;color:#0F766E'&gt;&lt;b style='color:#0F766E'&gt;UQ&lt;/b&gt;&lt;/td&gt;&lt;td style='font-size:11px'&gt;token: String&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px;width:55px;color:#0F766E'&gt;&lt;b style='color:#0F766E'&gt;FK · IDX&lt;/b&gt;&lt;/td&gt;&lt;td style='font-size:11px'&gt;userId: String&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px;width:55px;color:#0F766E'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='font-size:11px'&gt;expiresAt: DateTime&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px;width:55px;color:#0F766E'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='font-size:11px'&gt;createdAt: DateTime&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px;width:55px;color:#0F766E'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='font-size:11px'&gt;updatedAt: DateTime&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px;width:55px;color:#0F766E'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='font-size:11px'&gt;ipAddress: String?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='font-size:10px;width:55px;color:#0F766E'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='font-size:11px'&gt;userAgent: String?&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          
          
          
          
